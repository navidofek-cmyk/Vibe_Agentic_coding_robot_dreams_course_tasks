# Zkopíruj tento soubor jako .env a vyplň své API klíče:
#   cp .env.example .env

# Povinné pro Claude Code
ANTHROPIC_API_KEY=sk-ant-...

# Povinné pro Codex CLI
OPENAI_API_KEY=sk-...

# Volitelné – GitHub MCP server
# Získáš na: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...

# Volitelné – Brave Search MCP server
# Získáš na: https://api.search.brave.com/
BRAVE_API_KEY=BSA...
