/*--------------------------------*- C++ -*----------------------------------*\
  OpenFOAM – Cvičení 2: Pitz Daily (stacionární SIMPLE)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         300;

deltaT          1;

writeControl    timeStep;
writeInterval   50;
purgeWrite      3;

writeFormat     ascii;
writePrecision  6;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

functions
{
    residuals
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          (U p k epsilon);
        writeResidualFields no;
    }
}

// ************************************************************************* //
